<%@ page pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>

<dialog id="multi-filter-modal" class="modal multi-filter-modal"
	aria-labelledby="multi-filter-title">
<div class="modal-header">
	<h2 id="multi-filter-title">検索条件の選択</h2>
	<button type="button" class="icon-button" data-modal-close
		aria-label="閉じる">×</button>
</div>
<div class="modal-body">
	<form id="multi-filter-search" class="toolbar">
		<label class="sr-only" for="multi-filter-keyword">コードまたは名称で検索</label>
		<input id="multi-filter-keyword" name="keyword" type="text"
			autocomplete="off" maxlength="100" placeholder="コード・名称を入力して［Enter］" />
		<button class="btn btn-primary" type="submit">検索</button>
		<span class="muted">チェックした項目を適用してください。</span>
	</form>
	<p id="multi-filter-error" class="multi-error" role="status" hidden></p>
	<div class="table-wrap">
		<table class="data-table">
			<thead id="multi-filter-head"></thead>
			<tbody id="multi-filter-body"></tbody>
		</table>
	</div>
	<div id="multi-filter-pages" class="pagination"></div>
</div>
<div class="modal-footer">
	<button type="button" id="multi-filter-apply" class="btn btn-primary">適用</button>
	<button type="button" class="btn" data-modal-close>キャンセル</button>
	<span class="muted">検索やページ移動後もチェックした項目は保持されます。</span>
</div>
</dialog>
