<%@ page pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%-- c:url 안에서 포함한다. List를 하나의 문자열 파라미터로 합치지 않는다. --%>
<c:forEach var="multiParam" items="${filterIds}">
	<c:forEach var="filterId" items="${multiParam.value}">
		<c:param name="${multiParam.key}" value="${filterId}" />
	</c:forEach>
</c:forEach>
