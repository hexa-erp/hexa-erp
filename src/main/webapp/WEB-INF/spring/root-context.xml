<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:tx="http://www.springframework.org/schema/tx"
	xmlns:mybatis-spring="http://mybatis.org/schema/mybatis-spring"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
          http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
          http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx.xsd
          http://mybatis.org/schema/mybatis-spring http://mybatis.org/schema/mybatis-spring-1.2.xsd">
	<!-- DB・Mapper・Service・トランザクションはroot-context.xml、Controllerはservlet-context.xmlで設定する。 -->
	<context:property-placeholder
		location="classpath:db.properties, classpath:upload.properties" />

	<bean id="hikariConfig" class="com.zaxxer.hikari.HikariConfig">
		<property name="driverClassName" value="${db.driver}" />
		<property name="jdbcUrl" value="${db.url}" />
		<property name="username" value="${db.username}" />
		<property name="password" value="${db.password}" />
		<property name="maximumPoolSize" value="5" />
		<property name="minimumIdle" value="1" />
		<property name="poolName" value="hexa-erp-db" />
	</bean>

	<bean id="dataSource" class="com.zaxxer.hikari.HikariDataSource"
		destroy-method="close">
		<constructor-arg ref="hikariConfig" />
	</bean>

	<!-- DataSource → SqlSessionFactory → Mapper：同じ接続プールでMapperのSQLを実行する。 -->
	<bean id="sqlSessionFactory"
		class="org.mybatis.spring.SqlSessionFactoryBean">
		<property name="dataSource" ref="dataSource" />
		<property name="configLocation"
			value="classpath:mybatis-config.xml" />
		<!-- src/main/resources/hexa/erp/業務/mapper/の*Mapper.xmlを読み込む。 -->
		<property name="mapperLocations"
			value="classpath*:hexa/erp/*/mapper/*Mapper.xml" />
	</bean>

	<!-- 以下のmapperパッケージのインターフェースを自動登録する。 -->
	<mybatis-spring:scan
		base-package="hexa.erp.assignee.mapper,
			hexa.erp.partner.mapper,
			hexa.erp.warehouse.mapper,
			hexa.erp.item.mapper,
			hexa.erp.quotation.mapper,
			hexa.erp.salesorder.mapper,
			hexa.erp.sale.mapper,
			hexa.erp.shipinstruction.mapper,
			hexa.erp.shipment.mapper,
			hexa.erp.stock.mapper,
			hexa.erp.common.mapper"
		factory-ref="sqlSessionFactory" />

	<context:component-scan
		base-package="hexa.erp.assignee.service,
			hexa.erp.partner.service,
			hexa.erp.warehouse.service,
			hexa.erp.item.service,
			hexa.erp.quotation.service,
			hexa.erp.salesorder.service,
			hexa.erp.sale.service,
			hexa.erp.shipinstruction.service,
			hexa.erp.shipment.service,
			hexa.erp.stock.service,
			hexa.erp.common.service" />

	<!-- MyBatisと同じDataSourceを使用することで、commit・rollbackを一括適用する。 -->
	<bean id="transactionManager"
		class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
		<property name="dataSource" ref="dataSource" />
	</bean>
	<!-- Serviceの@Transactionalによるトランザクション処理を有効にする。 -->
	<tx:annotation-driven
		transaction-manager="transactionManager" />
</beans>
