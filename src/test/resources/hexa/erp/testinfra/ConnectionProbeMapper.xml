<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="hexa.erp.testinfra.ConnectionProbeMapper">
	<!-- 業務データ取得ではなく、DUALによる接続・マッピング確認用SQL。 -->
	<select id="selectProbe"
		resultType="hexa.erp.testinfra.ConnectionProbeRow">
		SELECT CAST(#{probeValue} AS VARCHAR2(30)) AS PROBE_VALUE,
		CAST(#{optionalNote} AS VARCHAR2(30)) AS OPTIONAL_NOTE
		FROM DUAL
	</select>
</mapper>
