<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
	<!-- Webテストでは実際のDBの代わりにStub Serviceを親Beanとして使用する。 -->
	<bean id="assigneeLookupService"
		class="hexa.erp.testinfra.StubAssigneeLookupService" />
	<bean id="partnerLookupService"
		class="hexa.erp.testinfra.StubPartnerLookupService" />
	<bean id="warehouseLookupService"
		class="hexa.erp.testinfra.StubWarehouseLookupService" />
	<bean id="itemLookupService"
		class="hexa.erp.testinfra.StubItemLookupService" />
	<bean id="quotationLookupService"
		class="hexa.erp.testinfra.StubQuotationLookupService" />
	<bean id="salesOrderLookupService"
		class="hexa.erp.testinfra.StubSalesOrderLookupService" />
	<bean id="saleLookupService"
		class="hexa.erp.testinfra.StubSaleLookupService" />
	<bean id="shipInstructionLookupService"
		class="hexa.erp.testinfra.StubShipInstructionLookupService" />
	<!-- 実際のMVC/API Controllerを維持し、業務Serviceを照会専用Stubに置き換える。 -->
	<bean id="partnerService"
		class="hexa.erp.testinfra.StubBusinessServices$Partner" />
	<bean id="warehouseService"
		class="hexa.erp.testinfra.StubBusinessServices$Warehouse" />
	<bean id="itemService"
		class="hexa.erp.testinfra.StubBusinessServices$Item" />
	<bean id="itemImageService"
		class="hexa.erp.testinfra.StubBusinessServices$ItemImage" />
	<bean id="stockService"
		class="hexa.erp.testinfra.StubBusinessServices$Stock" />
	<bean id="quotationService"
		class="hexa.erp.testinfra.StubBusinessServices$Quotation" />
	<bean id="quotationReportService"
		class="hexa.erp.testinfra.StubBusinessServices$QuotationReport" />
	<bean id="salesOrderService"
		class="hexa.erp.testinfra.StubBusinessServices$SalesOrder" />
	<bean id="salesOrderReportService"
		class="hexa.erp.testinfra.StubBusinessServices$SalesOrderReport" />
	<bean id="saleService"
		class="hexa.erp.testinfra.StubBusinessServices$Sale" />
	<bean id="saleStatusService"
		class="hexa.erp.testinfra.StubBusinessServices$SaleStatus" />
	<bean id="salePriceService"
		class="hexa.erp.testinfra.StubBusinessServices$SalePrice" />
	<bean id="shipInstructionService"
		class="hexa.erp.testinfra.StubBusinessServices$ShipInstruction" />
	<bean id="shipmentService"
		class="hexa.erp.testinfra.StubBusinessServices$Shipment" />
	<bean id="filterSelectionService"
		class="hexa.erp.common.service.FilterSelectionServiceImpl">
		<property name="assigneeLookupService"
			ref="assigneeLookupService" />
		<property name="partnerLookupService"
			ref="partnerLookupService" />
		<property name="warehouseLookupService"
			ref="warehouseLookupService" />
		<property name="itemLookupService" ref="itemLookupService" />
	</bean>
</beans>
